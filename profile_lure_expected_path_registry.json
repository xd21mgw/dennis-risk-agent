  "drift_gate": {
    "evaluation_order": [
      "source_status",
      "raw_present",
      "parser_success",
      "expected_path_seen",
      "text_normalization_result",
      "lure_token_match",
      "business_context_match",
      "final_status"
    ],
    "status_rules": [
      {
        "status": "profile_lure_detected",
        "when": "At least one expected path is source_completed, raw_present, parse_success, and has matched_lure_tokens or domain/contact/diversion semantics."
      },
      {
        "status": "true_no_evidence",
        "when": "All required sources for the evaluated wave are completed, raw is present, parser succeeded, expected paths were checked, and no lure/contact/diversion tokens or payload semantics were found."
      },
      {
        "status": "source_gap",
        "when": "Required source is auth_failed, timeout, blocked, not_called, or otherwise incomplete."
      },
      {
        "status": "parser_gap",
        "when": "Raw container exists but parser failed, parse_success is false, parse_error_count is nonzero for target container, or parsed children are absent due parser error."
      },
      {
        "status": "path_drift",
        "when": "Raw and parser succeeded, but known expected path is missing while semantically similar sibling/new path carries the payload."
      },
      {
        "status": "business_field_gap",
        "when": "Transport/parser completed but the business payload field is empty or not returned, such as current profile empty while history sources still need review."
      },
      {
        "status": "needs_more_source",
        "when": "URL/OCR/QR/domain enrichment or another source not implemented in this phase is required before closing the lure question."
      }
    ]
  }
